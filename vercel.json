{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node work/build-production.cjs",
  "outputDirectory": "public-site",
  "redirects": [
    {
      "source": "/fivecred-next",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fivecred-next/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fivecred-next/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/emprestimo-consignado-clt",
      "destination": "/clt-fivecred/index.html",
      "permanent": true
    },
    {
      "source": "/emprestimo-consignado-clt/",
      "destination": "/clt-fivecred/index.html",
      "permanent": true
    },
    {
      "source": "/emprestimo-consignado-clt.html",
      "destination": "/clt-fivecred/index.html",
      "permanent": true
    },
    {
      "source": "/emprestimo-fgts",
      "destination": "/fgts-fivecred/index.html",
      "permanent": true
    },
    {
      "source": "/emprestimo-fgts/",
      "destination": "/fgts-fivecred/index.html",
      "permanent": true
    },
    {
      "source": "/emprestimo-fgts.html",
      "destination": "/fgts-fivecred/index.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
